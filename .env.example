# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
JWT_SECRET=replace-with-at-least-64-random-characters
VITE_APP_ID=sbts-standalone
REQUEST_BODY_LIMIT=50mb
STORAGE_REQUIRED=false
ENABLE_MANUS_RUNTIME=false
ENABLE_OAUTH=false
OAUTH_SERVER_URL=

# ── Database (MySQL 8 / TiDB) ────────────────────────────────────────────────
DATABASE_URL=mysql://sbts:sbts_local_password@127.0.0.1:3307/sbts

# ── Initial administrator bootstrap ──────────────────────────────────────────
# Used only when running: pnpm admin:create
ADMIN_NAME=SBTS Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Replace-This-With-A-Strong-Password-123!
ADMIN_EMPLOYEE_NUMBER=SBTS-ADMIN
BOOTSTRAP_ADMIN_ON_DEPLOY=false

# ── Object storage option A: Railway Bucket / S3-compatible ─────────────────
# Railway Buckets can expose BUCKET, ENDPOINT, ACCESS_KEY_ID,
# SECRET_ACCESS_KEY and REGION directly. The S3_* aliases below also work.
S3_BUCKET=sbts
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=sbts_minio_admin
S3_SECRET_ACCESS_KEY=sbts_minio_local_password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── Object storage option B: Manus Forge legacy hosting ──────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# UAT/staging only. Keep false in real production.
SEED_DEMO_DATA=false
